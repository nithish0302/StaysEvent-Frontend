# Copy to .env and fill in real values. Never commit the actual .env file
# (it's already gitignored) — this file only documents what's required.
# Vite only exposes vars prefixed VITE_ to client-side code, and it inlines
# them at BUILD time — set these in your hosting platform's build-time env
# vars, not just its runtime ones, or the deployed build won't see them.

# This deployed backend's public API base, including /api. Example:
#   https://api.stayevents.app/api
VITE_API_URL=

# Cloudinary unsigned upload config (used for hotel/event photos and
# vendor ID/business documents). Cloud name from your Cloudinary dashboard;
# the preset must be created there as "Unsigned".
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_HOTEL_PRESET=
